# Copy to .env and fill in your own credentials. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.5-flash"
# Weekly search plus up to five AI drafts; set false to stop scheduling new cycles.
OPPORTUNITY_SCHEDULE_ENABLED="true"
# Optional per-division overrides: OPENROUTER_MODEL_ENGINEER,
# OPENROUTER_MODEL_CREATOR, OPENROUTER_MODEL_PAUD,
# OPENROUTER_MODEL_POSYANDU and OPENROUTER_MODEL_CYBER.
# Video generation is unavailable during the OpenRouter migration.
PORT=3000
HOST="127.0.0.1"
