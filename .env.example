# Copy to .env and fill in your own credentials. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Set true only after enabling billing and accepting video generation charges.
VIDEO_ENABLED="false"
# Leave empty to use Gemini for every division. Copilot requires an eligible token.
AI_COPILOT_DIVISIONS=""
COPILOT_GITHUB_TOKEN=""
COPILOT_MODEL=""
COPILOT_MODEL_ENGINEER=""
COPILOT_MODEL_CYBER=""
# Copilot per-session soft limit, not a hard cap on costs.
COPILOT_MAX_AI_CREDITS=""
PORT=3000
HOST="127.0.0.1"
