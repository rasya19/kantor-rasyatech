# Copy to .env and fill in your own credentials. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
OPENROUTER_API_KEY=""
# Optional: OpenRouter Management API Key for account-level credits balance.
OPENROUTER_MANAGEMENT_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Key-level monthly hard cap; the app blocks keys configured above this amount.
OPENROUTER_MAX_MONTHLY_USD="25"
# Default output token cap per request to prevent runaway costs.
OPENROUTER_DEFAULT_MAX_TOKENS="2400"
# Optional internal exchange rate used only to estimate net profit in IDR.
OPENROUTER_USD_IDR=""
# Primary model per division. Engineer also runs product research.
OPENROUTER_MODEL_ENGINEER="qwen/qwen-2.5-coder-32b-instruct"
OPENROUTER_MODEL_CYBER="google/gemini-2.5-flash"
OPENROUTER_MODEL_PAUD="google/gemini-2.5-flash"
OPENROUTER_MODEL_POSYANDU="google/gemini-2.5-flash"
OPENROUTER_MODEL_CREATOR="deepseek/deepseek-chat"
# OpenRouter tries fallbacks only when the primary fails. Fallback calls use cost-effective cross-provider models.
OPENROUTER_FALLBACK_MODELS_ENGINEER="deepseek/deepseek-chat,google/gemini-2.5-flash"
OPENROUTER_FALLBACK_MODELS_CYBER="deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct"
OPENROUTER_FALLBACK_MODELS_PAUD="deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct"
OPENROUTER_FALLBACK_MODELS_POSYANDU="deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct"
OPENROUTER_FALLBACK_MODELS_CREATOR="google/gemini-2.5-flash,qwen/qwen-2.5-72b-instruct"
# Video generation uses OpenRouter's dedicated asynchronous video API; the runtime switch starts OFF.
OPENROUTER_VIDEO_MODEL="heygen/heygen-video-1"
# Weekly web search starts OFF by default to prevent unexpected AI/search costs; set "true" to enable Monday 06:00 WIB runs.
OPPORTUNITY_SCHEDULE_ENABLED="false"
# Set a long unique password before using admin video controls. Video starts disabled.
OFFICE_ADMIN_PASSWORD=""
PORT=3000
HOST="127.0.0.1"
